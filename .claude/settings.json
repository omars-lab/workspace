{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "364000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE_IGNORE": "100"
  },
  "permissions": {
    "allow": [
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(sed:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(pbpaste:*)",
      "Bash(git rev-parse:*)",
      "Bash(make:*)",
      "Bash(brew:*)",
      "Bash(git:*)",
      "mcp__chrome-devtools__new_page"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-suggested-plugins.sh",
            "timeout": 5,
            "statusMessage": "Checking suggested plugins..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-bar.sh"
  },
  "enabledPlugins": {
    "reporting-manager@earlbear-claude-plugins": true,
    "plugin-marketplace-manager@earlbear-claude-plugins": true,
    "task-management-manager@earlbear-claude-plugins": true,
    "living-artifacts-manager@earlbear-claude-plugins": true,
    "repo-identity-manager@earlbear-claude-plugins": true,
    "decision-tracking-manager@earlbear-claude-plugins": true,
    "claude-routine-manager@earlbear-claude-plugins": true,
    "discover-oeid-plugins@oeid-claude-plugins": true,
    "config-manager@oeid-claude-plugins": true,
    "noteplan-manager@oeid-claude-plugins": true,
    "script-manager@oeid-claude-plugins": true,
    "claude-manager@oeid-claude-plugins": true,
    "spirituality-manager@oeid-claude-plugins": true,
    "knowledge-manager@oeid-claude-plugins": true,
    "note-manager@oeid-claude-plugins": true,
    "plan-manager@oeid-claude-plugins": true,
    "experiment-manager@oeid-claude-plugins": true,
    "code-quality-manager@oeid-claude-plugins": true,
    "servicenow-manager@oeid-claude-plugins": true,
    "role-manager@oeid-claude-plugins": true,
    "screenshot-manager@oeid-claude-plugins": true,
    "architecture-manager@oeid-claude-plugins": true,
    "cron-manager@oeid-claude-plugins": true,
    "profile-manager@oeid-claude-plugins": true,
    "code-repository-manager@oeid-claude-plugins": true,
    "design-partner@oeid-claude-plugins": true,
    "document-co-author@oeid-claude-plugins": true,
    "local-guide@oeid-claude-plugins": true,
    "consumer@oeid-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "earlbear-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/omareid/Workspace/git-earlbear/earlbear-claude-plugin-marketplace"
      }
    },
    "marketplace-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "EarlBear/marketplace-claude-plugins"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "claude-design-skillstack": {
      "source": {
        "source": "github",
        "repo": "freshtechbro/claudedesignskills"
      }
    },
    "shopify-ai-toolkit": {
      "source": {
        "source": "github",
        "repo": "Shopify/shopify-ai-toolkit"
      }
    }
  },
  "effortLevel": "high",
  "plansDirectory": ".claude/plans",
  "tui": "default",
  "autoMemoryDirectory": ".claude/memory",
  "skipWorkflowUsageWarning": true,
  "theme": "light-daltonized",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
