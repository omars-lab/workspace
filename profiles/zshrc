    _loader_msg "start" "🔗" "Loading shared workspace"
    # Save start time before nested loader calls that will overwrite it
    SAVED_START_TIME="${LOADER_START_TIME:-}"
    SAVED_START_MESSAGE="${LOADER_START_MESSAGE:-}"
    source "${SHARED_LOADER}" #tag:inject-sharedspace-loader
    # Restore start time for timing calculation
    export LOADER_START_TIME="${SAVED_START_TIME}"
    export LOADER_START_MESSAGE="${SAVED_START_MESSAGE}"
    _loader_msg "done" "🔗" "Loading shared workspace"
fi

# ============================================================================
# Python & Node Environment Setup
# ============================================================================
# Performance Optimization: Deferred loading of heavy environments
# https://code.visualstudio.com/docs/supporting/faq#_installation-appears-to-be-corrupt-unsupported

function continue-loading-profile() {

  # Activate Virtual Envs

  # >>> conda initialize >>>
  # !! Contents within this block are managed by 'conda init' !!
  _loader_msg "start" "🐍" "Initializing Conda"
  __conda_setup="$('${DIR_CONDA_HOME}/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
      eval "$__conda_setup"
  else
      if [ -f "${DIR_CONDA_HOME}/etc/profile.d/conda.sh" ]; then
	. "${DIR_CONDA_HOME}/etc/profile.d/conda.sh"  # commented out by conda initialize
      else
	# export PATH="${DIR_CONDA_HOME}/bin:$PATH"  # commented out by conda initialize
      fi
  fi
  unset __conda_setup
  # <<< conda initialize <<<
  
  # Install env if not existing
  _loader_msg "done" "🐍" "Initializing Conda"
  _loader_msg "start" "🐍" "Setting up Conda environment"
  (conda env list --json 2>/dev/null | jq -r '.envs | map(select(contains("/envs/"))) | .[]' 2>/dev/null | xargs basename 2>/dev/null | grep -q ${DEFAULT_CONDA_ENV} 2>/dev/null) || conda create -n ${DEFAULT_CONDA_ENV} -y python=3 pip >/dev/null 2>&1
  conda activate ${DEFAULT_CONDA_ENV} >/dev/null 2>&1
  _loader_msg "done" "🐍" "Setting up Conda environment"

  # NVM (Node Version Manager)
  _loader_msg "start" "📦" "Initializing NVM"
  if ( brew list nvm 2>/dev/null ); then
      # https://github.com/nvm-sh/nvm/issues/860
      # source $(brew --prefix nvm)/nvm.sh
      source $(brew --prefix)/opt/nvm/nvm.sh 2>/dev/null # using this instead of the above for performance ...
  else 
	if ( test -d "$HOME/.nvm" );
	export NVM_DIR="$HOME/.nvm"
	[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" 2>/dev/null # This loads nvm
  fi

  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion" 2>/dev/null # This loads nvm bash_completion
  nvm list ${DEFAULT_NVM_ENV} 1>/dev/null 2>/dev/null || nvm install ${DEFAULT_NVM_ENV} >/dev/null 2>&1
  nvm use ${DEFAULT_NVM_ENV} >/dev/null 2>&1
  _loader_msg "done" "📦" "Initializing NVM"

  # Ensure ~/.local/bin comes before NVM paths
  export PATH="${HOME}/.local/bin:$PATH"

  # Setup AI dependencies
  if command -v npm >/dev/null 2>&1; then
    _loader_msg "start" "🤖" "Setting up AI dependencies"
    # Check and install @google/gemini-cli
    if ! npm list -g @google/gemini-cli >/dev/null 2>&1; then
      npm install -g @google/gemini-cli >/dev/null 2>&1
    fi
    # NOT @anthropic-ai/claude-code — install it natively, via
    # `curl -fsSL https://claude.ai/install.sh | bash`, not from here.
    # The npm package's postinstall picks its prebuilt binary by
    # process.arch, so it inherits whatever node nvm happens to have
    # selected. On studio that is x64 v18.19.0, which silently produced
    # an x86_64 claude on an arm64 host — running under Rosetta and
    # warning "CPU lacks AVX support, strange crashes may occur" on
    # every launch. The native installer reads the machine, not node.
    # Check and install @musistudio/claude-code-router
    if ! npm list -g @musistudio/claude-code-router >/dev/null 2>&1; then
      npm install -g @musistudio/claude-code-router >/dev/null 2>&1
    fi
    _loader_msg "done" "🤖" "Setting up AI dependencies"
    
    # Load CCR preset if specified (optional)
    if [ -n "${CCR_PRESET:-}" ] && [ -f "${DIRS_ENVIRONMENT}/scripts/ccr-config" ]; then
      _loader_msg "start" "⚙️" "Loading CCR preset: ${CCR_PRESET}"
      source "${DIRS_ENVIRONMENT}/scripts/ccr-config" auto-load >/dev/null 2>&1 && \
        _loader_msg "done" "⚙️" "Loading CCR preset: ${CCR_PRESET}" || \
        _loader_msg "skip" "⚙️" "Loading CCR preset: ${CCR_PRESET}"
    fi
  fi

}

continue-loading-profile

