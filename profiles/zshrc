# ============================================================================
# Machine-local overrides (untracked)
# ============================================================================
# This profile is a symlink into a tracked repo that EVERY machine loads, so
# anything true of only one machine cannot live here. It lives in
# ~/.zshrc.local instead, and this is the line that reads it.
#
# It has to come first. Everything below — STUDIO_ROLE, SYNC_STUDIO_ROOT,
# STUDIO_LOCAL — is set with ${VAR:-default}, which defers only to a value that
# is ALREADY exported. Sourced later, the file would be read but could no longer
# change anything: setup.sh would still write STUDIO_ROLE=primary and the shell
# would still come up secondary, which is exactly what was happening before this
# line existed.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

