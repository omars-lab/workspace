# ============================================================================
# Shared Workspace Loader
# ============================================================================

SHARED_LOADER=$(first "${DIRS_ENVIRONMENT}/loader-shared.sh" "$(brew --prefix sharedspace)/loader-shared.sh" 2>/dev/null)
if [ -n "${SHARED_LOADER}" ] && [ -f "${SHARED_LOADER}" ]; then
